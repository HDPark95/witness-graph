{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/HDPark95/witness-graph/main/schemas/remediation.schema.json",
  "title": "Proposed remediation",
  "description": "A draft, never an action. Separating the proposal from the execution is what lets the harness prove zero unapproved changes.",
  "type": "object",
  "required": ["case_id", "steps", "blast_radius", "reversible"],
  "additionalProperties": false,
  "properties": {
    "case_id": { "type": "string" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action", "target", "rationale"],
        "properties": {
          "action": { "type": "string" },
          "target": { "type": "string" },
          "rationale": { "type": "string" },
          "cited_witnesses": { "type": "array", "items": { "type": "string", "pattern": "^e[0-9]+$" } }
        }
      }
    },
    "blast_radius": { "type": "array", "items": { "type": "string" }, "description": "Downstream assets affected, read from lineage rather than guessed." },
    "reversible": { "type": "boolean" },
    "verification": { "type": "string", "description": "How a human confirms the fix worked, stated before the fix is applied." }
  }
}
